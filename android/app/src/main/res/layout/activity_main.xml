<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E13">

    <TextView
        android:id="@+id/version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:gravity="center"
        android:textColor="#FFB82E"
        android:textSize="13sp"
        android:textStyle="bold"
        android:text="@string/version_loading"/>

    <LinearLayout
        android:id="@+id/updBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#141B24"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/updText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E9EEF2"
            android:textSize="14sp"
            android:paddingEnd="10dp"/>

        <Button
            android:id="@+id/updBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFB82E"
            android:textStyle="bold"
            android:text="@string/upd_button"/>
    </LinearLayout>

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
